# Assumes repo cloned to /opt/pt-nav.
# If deployed elsewhere, update WorkingDirectory and ExecStart, then run:
#   systemctl daemon-reload && systemctl restart pt-nav

[Unit]
Description=pt-nav Public Transit Navigation API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pt-nav
ExecStart=/opt/pt-nav/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
